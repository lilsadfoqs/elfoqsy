    },
    {
     "type": "heading",
     "attrs": {
      "level": 3
     },
     "content": [
      {
       "type": "text",
       "text": "Expected result"
      }
     ]
    },
    {
     "type": "paragraph",
     "content": [
      {
       "type": "text",
       "text": "Save Changes is disabled while any field of the drawer shows a validation error, as it already is for the Weight from and Weight to fields."
