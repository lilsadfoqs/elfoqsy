  {
   "id": "15933742",
   "author": {
    "accountId": "acc-11",
    "displayName": "Taylor Novak"
   },
   "created": "2026-10-13T04:53:48.635-0700",
   "items": [
    {
     "field": "Root cause description",
     "fieldId": "customfield_16595",
     "from": null,
     "fromString": null,
     "to": "",
     "toString": "The drawer computes {{canSave}} from the fields it validates on blur. The Excluded postcodes chip input validates on Enter and keeps its error in local state, so the form never learns about it."
    },
    {
     "field": "Solution",
     "fieldId": "customfield_16727",
     "from": null,
     "fromString": null,
     "to": "",
     "toString": "Move the chip input error into the form state with {{setFieldError}}, and derive {{canSave}} from every field error of the drawer."
    },
    {
     "field": "Acceptance criteria",
     "fieldId": "customfield_16728",
     "from": "",
     "fromString": "* With an invalid postcode in Excluded postcodes, Save Changes is disabled.\n* Removing the invalid chip enables Save Changes again.\n* Weight from and Weight to keep their current behaviour.\n* A valid list of postcodes saves as before.",
     "to": "",
     "toString": "* With an invalid postcode in Excluded postcodes, Save Changes is disabled.\n* Removing the invalid chip enables Save Changes again.\n* Weight from and Weight to keep their current behaviour.\n* A valid list of postcodes saves as before."
    },
    {
     "field": "Impact",
     "fieldId": "customfield_17581",
     "from": null,
     "fromString": null,
     "to": "",
     "toString": "Frontend: Admin, Shipping rules drawer (Excluded postcodes field). No backend or API change."
    }
   ]
  },
