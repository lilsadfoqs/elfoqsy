    {
     "type": "heading",
     "attrs": {
      "level": 3
     },
     "content": [
      {
       "type": "text",
       "text": "Actual result"
      }
     ]
    },
    {
     "type": "paragraph",
     "content": [
      {
       "type": "text",
       "text": "Save Changes stays enabled. Clicking it sends the rule with the invalid postcode, and the API answers 400 with a generic \"Something went wrong\" toast."
