        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "With an invalid postcode in Excluded postcodes, Save Changes is disabled."
          }
         ]
        }
       ]
      },
      {
       "type": "listItem",
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "Removing the invalid chip enables Save Changes again."
          }
         ]
        }
       ]
      },
      {
       "type": "listItem",
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "Weight from and Weight to keep their current behaviour."
          }
         ]
        }
       ]
      },
      {
       "type": "listItem",
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "A valid list of postcodes saves as before."
          }
         ]
        }
       ]
      }
     ]
    }
   ]
  },
  "customfield_16727": {
   "type": "doc",
   "version": 1,
   "content": [
    {
     "type": "paragraph",
     "content": [
      {
       "type": "text",
       "text": "Move the chip input error into the form state with "
      },
      {
       "type": "text",
       "text": "setFieldError",
       "marks": [
        {
         "type": "code"
        }
       ]
      },
      {
       "type": "text",
       "text": ", and derive "
      },
      {
       "type": "text",
       "text": "canSave",
       "marks": [
        {
         "type": "code"
        }
       ]
      },
      {
       "type": "text",
       "text": " from every field error of the drawer."
      }
     ]
    }
   ]
  },
