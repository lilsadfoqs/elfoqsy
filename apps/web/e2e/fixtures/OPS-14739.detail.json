  "customfield_16595": {
   "type": "doc",
   "version": 1,
   "content": [
    {
     "type": "paragraph",
     "content": [
      {
       "type": "text",
       "text": "The drawer computes "
      },
      {
       "type": "text",
       "text": "canSave",
       "marks": [
        {
         "type": "code"
        }
       ]
      },
      {
       "type": "text",
       "text": " from the fields it validates on blur. The Excluded postcodes chip input validates on Enter and keeps its error in local state, so the form never learns about it."
      }
     ]
    }
   ]
