  "customfield_16728": {
   "type": "doc",
   "version": 1,
   "content": [
    {
     "type": "bulletList",
     "content": [
      {
       "type": "listItem",
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "With the flag at 100% in staging, 10 000 synthetic checkouts end with no captured payment that lacks an order."
          }
         ]
        }
       ]
      },
      {
       "type": "listItem",
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "Killing any activity worker mid-checkout resumes the checkout from its last completed step."
          }
         ]
        }
       ]
      },
      {
       "type": "listItem",
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "A payment declined after the stock was reserved releases the stock within 5 seconds."
          }
         ]
        }
       ]
      },
      {
       "type": "listItem",
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "Checkout P90 on the new path is no worse than on the saga path."
          }
         ]
        }
       ]
      },
      {
       "type": "listItem",
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "Replay tests run in CI on every pull request that touches the workflow."
          }
         ]
        }
       ]
      }
     ]
    }
   ]
  },
