  "customfield_16728": {
   "type": "doc",
   "version": 1,
   "content": [
    {
     "type": "orderedList",
     "content": [
      {
       "type": "listItem",
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "Fault injection (worker killed mid-commit, InventorySynced lost, Postgres unavailable for 10 minutes) loses no stock update and decrements no item twice."
          }
         ]
        }
       ]
      },
      {
       "type": "listItem",
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "A hold is released only after the stock commit is confirmed, or when the payment expires or is refunded."
          }
         ]
        }
       ]
      },
      {
       "type": "listItem",
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "Guest carts that never reach checkout are never synced."
          }
         ]
        }
       ]
      },
      {
       "type": "listItem",
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "The reconcile job reports and releases holds left over for more than 24 hours."
          }
         ]
        }
       ]
      }
     ]
    }
   ]
  },
