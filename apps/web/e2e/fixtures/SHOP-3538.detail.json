  "description": {
   "type": "doc",
   "version": 1,
   "content": [
    {
     "type": "heading",
     "attrs": {
      "level": 3
     },
     "content": [
      {
       "type": "text",
       "text": "Why"
      }
     ]
    },
    {
     "type": "paragraph",
     "content": [
      {
       "type": "text",
       "text": "With holds now placed in the reservation store at add-to-cart (CORE-18632), the stock count in the inventory database is only decremented after payment capture. Losing that commit is the hardest failure of Checkout V2: the order ships, the shelf count stays high, and the next customer buys an item that is not there."
      }
     ]
    },
    {
     "type": "heading",
     "attrs": {
      "level": 3
     },
     "content": [
      {
       "type": "text",
       "text": "Scope"
      }
     ]
    },
    {
     "type": "bulletList",
     "content": [
      {
       "type": "listItem",
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "New worker "
          },
          {
           "type": "text",
           "text": "shop-worker/src/inventory_sync",
           "marks": [
            {
             "type": "code"
            }
           ]
          },
          {
           "type": "text",
           "text": " (TypeScript, Node 24, Vitest)."
          }
         ]
        }
       ]
      },
      {
       "type": "listItem",
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "Trigger: the payments webhook handler (v2, v3 and the expiry path) produces an "
          },
          {
           "type": "text",
           "text": "InventorySyncCommand",
           "marks": [
            {
             "type": "code"
            }
           ]
          },
          {
           "type": "text",
           "text": " on Kafka once the payment is captured or the hold expires."
          }
         ]
        }
       ]
      },
      {
       "type": "listItem",
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "On capture: decrement the stock in Postgres in one transaction keyed by "
          },
          {
           "type": "text",
           "text": "order_id",
           "marks": [
            {
             "type": "code"
            }
           ]
          },
          {
           "type": "text",
           "text": ", then emit "
          },
          {
           "type": "text",
           "text": "InventorySynced",
           "marks": [
            {
             "type": "code"
            }
           ]
          },
          {
           "type": "text",
           "text": " and release the hold in Redis."
          }
         ]
        }
       ]
      },
      {
       "type": "listItem",
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "On expiry or refund before shipping: release the hold only; the stock count is never touched."
          }
         ]
        }
       ]
      },
      {
       "type": "listItem",
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "A nightly reconcile job lists holds older than 24 h with no matching order and releases them."
          }
         ]
        }
       ]
      },
      {
       "type": "listItem",
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "Guest carts that never reach checkout are never synced."
          }
         ]
        }
       ]
      }
     ]
    },
    {
     "type": "heading",
     "attrs": {
      "level": 3
     },
     "content": [
      {
       "type": "text",
       "text": "Dependencies"
      }
     ]
    },
    {
     "type": "bulletList",
     "content": [
      {
       "type": "listItem",
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "SHOP-3537 (reservation store) and SHOP-3543 (Kafka topics, Redis streams) must land first."
          }
         ]
        }
       ]
      },
      {
       "type": "listItem",
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "SHOP-3559 defines the InventorySyncCommand and InventorySynced messages."
          }
         ]
        }
       ]
      }
     ]
    },
    {
     "type": "heading",
     "attrs": {
      "level": 3
     },
     "content": [
      {
       "type": "text",
       "text": "Source"
      }
     ]
    },
    {
     "type": "paragraph",
     "content": [
      {
       "type": "text",
       "text": "Requirement CHK2-P04 in "
      },
      {
       "type": "text",
       "text": "Checkout V2 :: Requirements",
       "marks": [
        {
         "type": "link",
         "attrs": {
          "href": "https://acme.atlassian.net/wiki/spaces/SHOP/pages/7340021"
         }
        }
       ]
      },
      {
       "type": "text",
       "text": ", design in "
      },
      {
       "type": "text",
       "text": "Checkout V2 :: Architecture",
       "marks": [
        {
         "type": "link",
         "attrs": {
          "href": "https://acme.atlassian.net/wiki/spaces/SHOP/pages/7340022"
         }
        }
       ]
      },
      {
       "type": "text",
       "text": " and "
      },
      {
       "type": "text",
       "text": "Checkout V2 :: Stock Reservations",
       "marks": [
        {
         "type": "link",
         "attrs": {
          "href": "https://acme.atlassian.net/wiki/spaces/SHOP/pages/7340023"
         }
        }
       ]
      },
      {
       "type": "text",
       "text": "."
      }
     ]
    }
   ]
  },
