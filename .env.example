# Live mode only. Simulate mode (pnpm dev:sim) needs none of this.
# Copy to .env at the repository root; the daemon reads it at start. Never commit .env.

# Jira Cloud: the tickets in the open sprints of these projects.
JIRA_SITE=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECTS=SHOP,CORE

# GitHub: the repositories whose open PRs are linked to tickets by key (owner/name, comma-separated).
# Reads go through the gh CLI you are logged in with (gh auth login).
GITHUB_REPOS=acme/shop-api,acme/shop-worker,acme/shop-shared

# Where your clones live (read-only). Agents work in their own clones under WORKTREES_ROOT.
REPOS_ROOT=/home/you/code
# WORKTREES_ROOT=/home/you/.local/share/elfoqsy/runs

# Optional: logs through Coralogix (non-prod, read-only).
# CORALOGIX_API_KEY=
# CORALOGIX_DOMAIN=us1.coralogix.com

# Optional: ports.
# DAEMON_PORT=4317
